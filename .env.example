# Skopiuj ten plik jako `.env` i uzupełnij wartości.
# Pliku `.env` nie wysyłamy do repozytorium (jest w .gitignore).
# Na Vercelu te same zmienne ustawia się w Settings → Environment Variables.

# Identyfikator Google Analytics 4, np. G-XXXXXXXXXX
# Dopóki jest pusty, Analytics NIE ładuje się wcale — strona działa bez niego,
# a zdarzenia (np. pobrania prezentacji) czekają w kolejce i zostaną policzone
# od momentu włączenia.
PUBLIC_GA_ID=

# Adres, pod który formularze wysyłają zgłoszenia.
# Domyślnie ustawiony w src/config.ts; tutaj można go nadpisać przy testach,
# żeby nie zaśmiecać prawdziwej skrzynki.
PUBLIC_FORM_ENDPOINT=

# Docelowo: własny adres wysyłający prezentację w załączniku (usługa Resend).
PUBLIC_DECK_ENDPOINT=

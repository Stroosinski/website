# Skopiuj ten plik jako `.env` i uzupełnij wartości.
# Pliku `.env` nie wysyłamy do repozytorium (jest w .gitignore).

# Adres, pod który formularz kontaktowy wysyła zgłoszenia.
# Po założeniu formularza w serwisie (np. Formspree) wklej tu jego endpoint,
# np. https://formspree.io/f/xxxxxxxx
# Dopóki jest pusty, formularz otwiera klienta poczty zamiast wysyłać w tle.
PUBLIC_FORM_ENDPOINT=

---
import Base from '@/layouts/Base.astro';
---

<Base
  title="STOLMAR — Window displays, exhibitions & scenography"
  description="Od ponad 30 lat projektujemy i produkujemy witryny sklepowe, meble, stoiska targowe i scenografię dla marek premium. Od koncepcji po montaż."
  lang="pl"
  path="/"
>
  <main style="min-height:100vh;display:grid;place-items:center;color:#f4f2ec;font-family:system-ui,sans-serif;text-align:center;padding:2rem;">
    <div>
      <p style="letter-spacing:.34em;text-transform:uppercase;font-size:.75rem;color:#efd32b;">Szkielet gotowy</p>
      <h1 style="font-size:clamp(2rem,6vw,4rem);letter-spacing:-.02em;text-transform:uppercase;margin:.5rem 0;">STOLMAR</h1>
      <p style="max-width:32ch;margin:0 auto;opacity:.7;font-size:.9rem;">
        Projekt Astro działa. Kolejny krok: przeniesienie gotowej treści z Claude&nbsp;Design.
      </p>
    </div>
  </main>
</Base>

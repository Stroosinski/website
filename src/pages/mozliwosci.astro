---
import Page from '@/layouts/Page.astro';
import StudioIntro from '@/components/StudioIntro.astro';
import Services from '@/components/Services.astro';
import InHouse from '@/components/InHouse.astro';
import DeckForm from '@/components/DeckForm.astro';
---

<Page lang="pl" route="studio">
  <div data-screen-label="Studio" style="position: relative; isolation: isolate;">
    <!-- Tło z animowaną siatką kropek (oryginał, linie 558-560). -->
    <div
      aria-hidden="true"
      style="position: fixed; inset: 0; z-index: -1; opacity: 0.1; pointer-events: none;"
    >
      <dot-matrix
        frequency="2"
        speed="4"
        cellsize="10"
        gamma="5"
        chars="X"
        c0="#FFFFFF"
        c1="#EFD32B"
        c2="#000000"
        style="width: 100%; height: 100%;"></dot-matrix>
    </div>

    <StudioIntro lang="pl" />
    <Services lang="pl" />
    <InHouse lang="pl" />
    <DeckForm lang="pl" />
  </div>
</Page>

<script src="/js/dot-matrix.js" is:inline defer></script>

<script>
  import '@/scripts/veil';
  import '@/scripts/reveal';
  import '@/scripts/typewriter';
</script>

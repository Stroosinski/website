---
/**
 * Przycisk 1:1 z design systemu STOLMAR (components/core/Button.jsx).
 * Wartości przepisane z _ds_bundle.js — stałe wysokości 34/44/54 px,
 * odstęp liter 0.08em, kanciasty (--radius-sm), wciśnięcie = 1px w dół.
 * Wariant `secondary` jest zaprojektowany na jasne tło; na ciemnym oryginał
 * nadpisywał go bielą i ramką #3A3A3A (secondaryBtnProps) — stąd `on-dark`.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  onDark?: boolean;
  fullWidth?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  onDark = false,
  fullWidth = false,
  class: className = '',
} = Astro.props;
---

<a
  href={href}
  class:list={[
    'ds-btn',
    `v-${variant}`,
    `s-${size}`,
    { 'on-dark': onDark, 'is-full': fullWidth },
    className,
  ]}
>
  <slot />
</a>

<style>
  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans, 'Roboto', sans-serif);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 2px);
    cursor: pointer;
    transition:
      background var(--dur-fast, 120ms) var(--ease-standard, cubic-bezier(0.16, 1, 0.3, 1)),
      color var(--dur-fast, 120ms) var(--ease-standard, cubic-bezier(0.16, 1, 0.3, 1)),
      border-color var(--dur-fast, 120ms) var(--ease-standard, cubic-bezier(0.16, 1, 0.3, 1)),
      transform var(--dur-fast, 120ms) var(--ease-standard, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .ds-btn:active {
    transform: translateY(1px);
  }
  .ds-btn:focus-visible {
    outline: 2px solid var(--signal-yellow, #efd32b);
    outline-offset: 2px;
  }
  .is-full {
    display: flex;
    width: 100%;
  }

  /* rozmiary — wysokości i padding wprost z design systemu */
  .s-sm {
    height: 34px;
    padding: 0 14px;
    font-size: 11px;
    gap: 8px;
  }
  .s-md {
    height: 44px;
    padding: 0 20px;
    font-size: 12px;
    gap: 10px;
  }
  .s-lg {
    height: 54px;
    padding: 0 28px;
    font-size: 13px;
    gap: 12px;
  }

  /* warianty */
  .v-primary {
    background: var(--ink-900, #0a0a0a);
    color: var(--paper-000, #fff);
  }
  .v-primary:hover {
    background: var(--ink-700, #1f1f1f);
  }

  .v-accent {
    background: var(--signal-yellow, #efd32b);
    color: var(--ink-900, #0a0a0a);
  }
  .v-accent:hover {
    background: var(--signal-yellow-deep, #d9be18);
  }

  .v-secondary {
    background: transparent;
    color: var(--ink-900, #0a0a0a);
    border-color: var(--ink-900, #0a0a0a);
  }
  .v-secondary:hover {
    background: var(--ink-900, #0a0a0a);
    color: var(--paper-000, #fff);
  }
  /* nadpisanie na ciemnym tle (oryginalne secondaryBtnProps) */
  .v-secondary.on-dark {
    color: #fff;
    border-color: #3a3a3a;
  }
  .v-secondary.on-dark:hover {
    background: #fff;
    color: var(--ink-900, #0a0a0a);
    border-color: #fff;
  }

  .v-ghost {
    background: transparent;
    color: var(--ink-900, #0a0a0a);
  }
  .v-ghost:hover {
    background: rgba(10, 10, 10, 0.06);
  }
  .v-ghost.on-dark {
    color: #f4f2ec;
  }
  .v-ghost.on-dark:hover {
    background: rgba(255, 255, 255, 0.08);
  }
</style>

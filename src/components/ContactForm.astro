---
/**
 * Formularz kontaktowy — oryginał, linie 707-732.
 *
 * Pola 1:1 z design systemu (components/forms/Input.jsx, wariant on-dark):
 * etykieta 11 px / 0.14em / wersaliki / kolor przygaszony, pole bez ramki
 * z dolną kreską #3A3A3A, 15 px, przy aktywności kreska i etykieta na żółto.
 * Trzy pola: imię, e-mail, brief — plus załączniki i przycisk pełnej szerokości.
 *
 * Wcześniejsza wersja miała kafelki wyboru tematu i pole „Firma" — nie ma ich
 * w oryginale, zostały usunięte.
 *
 * Wysyłka: komunikat sukcesu WYŁĄCZNIE po potwierdzeniu z serwera. W oryginale
 * formularz zawsze pokazywał sukces i kasował dane, przez co zapytania ofertowe
 * przepadały (patrz ODSTEPSTWA.md).
 */
import { useTranslations, type Locale } from '@/i18n';
import { FORM_ENDPOINT } from '@/config';
import en from '@/content/site.en.json';
import pl from '@/content/site.pl.json';

interface Props {
  lang: Locale;
  action?: string;
}
const { lang, action = FORM_ENDPOINT } = Astro.props;
const t = useTranslations(lang);

type Form = {
  name: string; namePh: string; email: string; emailPh: string;
  brief: string; briefPh: string; files: string; filesCta: string;
  filesHint: string; btn: string;
};
const f = (lang === 'pl' ? pl : en).form as Form;

const ui =
  lang === 'pl'
    ? {
        sending: 'Wysyłanie...',
        error: 'Nie udało się wysłać. Spróbuj ponownie lub napisz na info@stolmar.co.',
        offline: 'Brak połączenia. Sprawdź internet i spróbuj ponownie.',
        subject: 'Zapytanie ze strony stolmar.co',
        noFiles: 'Brak wybranych plików',
        someFiles: (n: number) => `${n} plików wybranych`,
      }
    : {
        sending: 'Sending...',
        error: 'Could not send. Please try again or write to info@stolmar.co.',
        offline: 'No connection. Check your internet and try again.',
        subject: 'Enquiry from stolmar.co',
        noFiles: 'No files selected',
        someFiles: (n: number) => `${n} files selected`,
      };

const labelStyle =
  'font-family: inherit; font-weight: 500; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #7E7E7A; transition: color 200ms cubic-bezier(0.16,1,0.3,1);';
const fieldWrap = 'display: flex; flex-direction: column; gap: 4px;';
---

<!-- Komunikat po wysłaniu (oryginał, linie 709-713) -->
<div
  data-form-sent
  hidden
  style="height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 18px;"
>
  <span
    style="align-self: flex-start; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #0A0A0A; background: var(--signal-yellow); padding: 7px 12px;"
    >{t('contact.sentBadge')}</span
  >
  <div
    style="font-weight: 900; text-transform: uppercase; font-size: 30px; color: #FFFFFF; letter-spacing: -0.01em;"
  >
    {t('contact.sentTitle')}
  </div>
  <p style="margin: 0; color: #C9C7C1; font-weight: 300; max-width: 340px; line-height: 1.7;">
    {t('contact.sentBody')}
  </p>
</div>

<form
  class="stlm-cform"
  data-contact-form
  data-reveal
  method="POST"
  action={action}
  enctype="multipart/form-data"
  data-sending-label={ui.sending}
  data-error-label={ui.error}
  data-offline-label={ui.offline}
  data-no-files={ui.noFiles}
  data-some-files={ui.someFiles(0).replace('0 ', '')}
  style="display: flex; flex-direction: column; gap: 28px;"
>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="cf-gotcha" />
  <input type="hidden" name="_subject" value={ui.subject} />
  <input type="hidden" name="lang" value={lang} />

  <div style={fieldWrap}>
    <label for="stlm-name" style={labelStyle}>{f.name}</label>
    <input id="stlm-name" type="text" name="name" required autocomplete="name" placeholder={f.namePh} />
  </div>

  <div style={fieldWrap}>
    <label for="stlm-email" style={labelStyle}>{f.email}</label>
    <input id="stlm-email" type="email" name="email" required autocomplete="email" placeholder={f.emailPh} />
  </div>

  <div style={fieldWrap}>
    <label for="stlm-brief" style={labelStyle}>{f.brief}</label>
    <textarea id="stlm-brief" name="brief" rows="3" placeholder={f.briefPh}></textarea>
  </div>

  <div style={fieldWrap}>
    <label for="stlm-files" style={labelStyle}>{f.files}</label>
    <label
      for="stlm-files"
      style="display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; box-sizing: border-box; border-bottom: 1px solid #3A3A3A; padding: 10px 0; cursor: pointer;"
    >
      <span
        data-files-summary
        style="font-size: 15px; color: #C9C7C1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
        >{ui.noFiles}</span
      >
      <span
        style="font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--signal-yellow); flex-shrink: 0;"
        >{f.filesCta}</span
      >
    </label>
    <input id="stlm-files" type="file" name="files" multiple style="display: none;" />
    <span style="font-size: 11px; color: #7E7E7A; letter-spacing: 0.02em;">{f.filesHint}</span>
  </div>

  <p data-form-error hidden role="alert" class="cf-err"></p>

  <button type="submit" class="stlm-cform-btn">{f.btn}</button>
</form>

<style is:global>
  /* Pola wg design systemu, wariant on-dark. */
  .stlm-cform input[type='text'],
  .stlm-cform input[type='email'],
  .stlm-cform textarea {
    width: 100%;
    box-sizing: border-box;
    background: transparent;
    border: none;
    border-bottom: 1px solid #3a3a3a;
    border-radius: 0;
    padding: 10px 0;
    font-family: var(--font-sans, 'Roboto', sans-serif);
    font-weight: 400;
    font-size: 15px;
    color: #f4f2ec;
    outline: none;
    transition: border-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stlm-cform textarea {
    resize: vertical;
  }
  .stlm-cform input::placeholder,
  .stlm-cform textarea::placeholder {
    color: #5a5a57;
  }
  .stlm-cform input:focus,
  .stlm-cform textarea:focus {
    border-bottom-color: var(--signal-yellow, #efd32b);
  }
  /* etykieta rozjaśnia się na żółto przy aktywnym polu — jak w design systemie */
  .stlm-cform > div:focus-within > label:first-child {
    color: var(--signal-yellow, #efd32b) !important;
  }

  .stlm-cform-btn {
    display: flex;
    width: 100%;
    height: 54px;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans, 'Roboto', sans-serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-900, #0a0a0a);
    background: var(--signal-yellow, #efd32b);
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 2px);
    cursor: pointer;
    transition: background 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stlm-cform-btn:hover {
    background: var(--signal-yellow-deep, #d9be18);
  }
  .stlm-cform-btn:active {
    transform: translateY(1px);
  }
  .stlm-cform-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* pułapka na roboty — niewidoczna, ale nie display:none */
  .cf-gotcha {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cf-err {
    margin: 0;
    padding: 12px 14px;
    border-left: 2px solid #efd32b;
    background: rgba(239, 211, 43, 0.06);
    font-size: 14px;
    font-weight: 300;
    color: #f4f2ec;
  }
</style>

<script>
  import '@/scripts/form';
</script>

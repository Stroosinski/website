---
/**
 * Dane strukturalne JSON-LD.
 * Dzięki nim Google i asystenci AI wiedzą, czym firma się zajmuje, gdzie jest
 * i jak się skontaktować - to warstwa, na której opiera się GEO i lokalne SEO.
 * Dane firmowe za wytycznymi marki STOLMAR.
 */
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
  /** dołącz pełny profil firmy (strona główna i kontakt) */
  full?: boolean;
  /**
   * Pytania i odpowiedzi do bloku FAQPage (tylko strona FAQ).
   * To jest warstwa pod GEO: modele językowe cytują gotowe pary Q&A,
   * a Google potrafi pokazać je jako rozwijane odpowiedzi w wynikach.
   */
  faq?: { q: string; a: string }[];
}

const { lang, full = false, faq } = Astro.props;
const site = (Astro.site ?? new URL('https://stolmar.co')).origin;

const description =
  lang === 'pl'
    ? 'Producent witryn sklepowych, mebli, stoisk targowych i scenografii dla marek premium. Projekt, prototyp, produkcja i montaż w jednej pracowni.'
    : 'Producer of shop windows, furniture, exhibition stands and scenography for premium brands. Concept, prototyping, production and on-site assembly in one workshop.';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'STOLMAR',
  legalName: 'STOLMAR Marian Czajkowski Sp. k.',
  url: site,
  logo: `${site}/assets/logo-full.png`,
  description,
  foundingDate: '1995',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Hodowlana 7',
    addressLocality: 'Rumia',
    postalCode: '84-230',
    addressCountry: 'PL',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+48505999275',
    email: 'info@stolmar.co',
    contactType: 'sales',
    availableLanguage: ['pl', 'en'],
  },
  sameAs: [
    'https://www.instagram.com/stolmar_manufabryka/',
    'https://www.linkedin.com/company/stolmar-displays',
  ],
};

// LocalBusiness - pod wyszukiwania lokalne ("producent witryn sklepowych Trójmiasto")
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}/#localbusiness`,
  name: 'STOLMAR',
  // Kadr 1200x630, nie samo logo - Google oczekuje tu obrazu o proporcjach
  // zbliżonych do poziomych i przycina nietypowe formaty.
  image: `${site}/assets/og-image.png`,
  url: site,
  telephone: '+48505999275',
  email: 'info@stolmar.co',
  address: organization.address,
  /**
   * Współrzędne pracowni (Hodowlana 7, Rumia). Pobrane z bazy adresowej
   * OpenStreetMap 2026-08-16 - trafienie dokładne, z numerem budynku.
   * NIE wpisywać „na oko": Google używa tego punktu w wynikach lokalnych
   * i w mapach, więc błąd wysyła klientów pod zły adres.
   */
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 54.574036,
    longitude: 18.379523,
  },
  // Godziny pracy pracowni - poniedziałek–piątek, bez sobót
  // (potwierdzone przez właściciela 2026-08-16).
  // Google pokazuje je w wynikach lokalnych i w wizytówce firmy.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  ],
  areaServed: [
    { '@type': 'Country', name: 'Poland' },
    { '@type': 'Country', name: 'Germany' },
    { '@type': 'Country', name: 'France' },
    { '@type': 'Country', name: 'Czech Republic' },
    { '@type': 'Country', name: 'Austria' },
  ],
  makesOffer: [
    'Window displays',
    'In-store decorations',
    'Pop-up stores',
    'Exhibition stands',
    'Event scenography',
    'Prototypes',
  ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site}/#website`,
  url: site,
  name: 'STOLMAR',
  publisher: { '@id': `${site}/#organization` },
  inLanguage: lang === 'pl' ? 'pl-PL' : 'en-US',
};

/**
 * FAQPage - jeden blok obejmujący WSZYSTKIE pytania ze strony.
 * Google wymaga, żeby każda odpowiedź tu obecna była też widoczna dla
 * użytkownika na stronie (inaczej traktuje to jako ukrytą treść), dlatego
 * bierzemy dokładnie te same teksty co render, bez skracania.
 */
const faqPage =
  faq && faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': `${site}${lang === 'pl' ? '/faq/' : '/en/faq/'}#faq`,
        inLanguage: lang === 'pl' ? 'pl-PL' : 'en-US',
        publisher: { '@id': `${site}/#organization` },
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;

const blocks = [
  ...(full ? [organization, localBusiness] : []),
  website,
  ...(faqPage ? [faqPage] : []),
];
---

{
  blocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}

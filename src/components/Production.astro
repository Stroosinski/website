---
/**
 * Sekcja "Ciężar precyzji" - oryginał, linie 652-663.
 * Karuzela 39 kadrów produkcyjnych (ProdCoverflow) montowana jako wyspa React.
 *
 * Uwaga z importu: te 39 zdjęć nie zostało wypakowanych za pierwszym razem,
 * bo ich ścieżki powstają w kodzie komponentu, a nie w HTML - skan referencji
 * ich nie widział. Dociągnięte później z archiwum projektu.
 */
import { useTranslations, type Locale } from '@/i18n';
import ProdCoverflow from './ProdCoverflow.jsx';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const nav =
  lang === 'pl'
    ? { prev: 'Poprzednie', next: 'Następne', alt: 'Detal produkcyjny - realizacja STOLMAR' }
    : { prev: 'Previous', next: 'Next', alt: 'Production detail - STOLMAR' };
---

<section style="border-top: 1px solid #161616;">
  <div
    style="max-width: 1360px; margin: 0 auto; padding: clamp(64px, 8vw, 110px) 40px clamp(56px, 7vw, 96px);"
  >
    <div style="margin-bottom: 14px;">
      <div
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase; color: var(--signal-yellow);"
      >
        {t('prod.eye')}
      </div>
    </div>
    <h2
      style="margin: 0; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(34px, 5vw, 72px); line-height: 0.98; letter-spacing: -0.02em; max-width: 760px;"
    >
      {t('prod.h')}
    </h2>

    <div
      style="position: relative; margin-top: clamp(48px, 6vw, 80px); margin-bottom: clamp(16px, 96px - 6vw, 56px); height: clamp(360px, 44vw, 560px); width: 100%;"
    >
      <ProdCoverflow client:visible prevLabel={nav.prev} nextLabel={nav.next} alt={nav.alt} />
    </div>
  </div>
</section>

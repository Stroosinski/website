---
/**
 * Siatka realizacji z filtrowaniem po rodzaju prac.
 * Wszystkie karty są w HTML od razu - filtr tylko je ukrywa, więc wyszukiwarki
 * widzą komplet, niezależnie od wybranej zakładki.
 */
import { useTranslations, type Locale } from '@/i18n';
import en from '@/content/site.en.json';
import pl from '@/content/site.pl.json';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

type Project = {
  eyebrow: string; title: string; materials: string[];
  tag: string; tagLabel: string; year: string; image: string;
};
const data = lang === 'pl' ? pl : en;
const projects = data.projects as Project[];
const filters = data.filters as Record<string, string>;

const toSrc = (p: string) => (p.startsWith('/') ? p : `/${p}`);
const filterKeys = Object.keys(filters);
const altFor = (p: Project) =>
  lang === 'pl'
    ? `${p.title} - realizacja STOLMAR, ${p.eyebrow}`
    : `${p.title} - STOLMAR project, ${p.eyebrow}`;
---

<section class="pg">
  <div class="pg-filters" role="group" aria-label={t('work.note')}>
    {
      filterKeys.map((key, i) => (
        <button
          type="button"
          class:list={['pg-filter', { 'is-active': i === 0 }]}
          data-filter={key}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {filters[key]}
        </button>
      ))
    }
  </div>

  <ul class="pg-grid">
    {
      projects.map((p) => (
        <li class="pg-item" data-tag={p.tag}>
          <article class="pg-card" data-hgroup data-hborder="1">
            <div class="pg-media">
              <img
                data-h-img
                data-off="0.42"
                data-on="0.78"
                src={toSrc(p.image)}
                alt={altFor(p)}
                loading="lazy"
                decoding="async"
              />
              <span aria-hidden="true" class="pg-scrim" />
              <span class="pg-tag">{p.tagLabel}</span>
            </div>
            <div class="pg-body">
              <p class="pg-eyebrow">{p.eyebrow}</p>
              <h2 class="pg-title">{p.title}</h2>
              <ul class="pg-materials">
                {p.materials.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ul>

  <p class="pg-empty" hidden>{lang === 'pl' ? 'Brak realizacji w tej kategorii.' : 'No projects in this category.'}</p>
</section>

<style>
  .pg {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px 120px;
  }
  .pg-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .pg-filter {
    font-family: inherit;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7e7e7a;
    background: transparent;
    border: 1px solid #3a3a3a;
    border-radius: 2px;
    padding: 9px 16px;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }
  .pg-filter:hover {
    color: #f4f2ec;
    border-color: #7e7e7a;
  }
  .pg-filter.is-active {
    color: #0a0a0a;
    background: var(--signal-yellow, #efd32b);
    border-color: var(--signal-yellow, #efd32b);
  }
  .pg-filter:focus-visible {
    outline: 2px solid #efd32b;
    outline-offset: 2px;
  }

  .pg-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .pg-item[hidden] {
    display: none;
  }
  .pg-card {
    height: 100%;
    border: 1px solid #222;
    overflow: hidden;
    transition: border-color 0.42s ease;
  }
  .pg-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .pg-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.42;
    transform: scale(1.06);
    transition:
      opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pg-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.1) 60%);
  }
  .pg-tag {
    position: absolute;
    left: 16px;
    top: 14px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--signal-yellow, #efd32b);
    border: 1px solid rgba(239, 211, 43, 0.4);
    border-radius: 999px;
    padding: 4px 10px;
    background: rgba(10, 10, 10, 0.6);
  }
  .pg-body {
    padding: 24px 22px 28px;
  }
  .pg-eyebrow {
    margin: 0 0 10px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7e7e7a;
  }
  .pg-title {
    margin: 0 0 16px;
    font-weight: 900;
    text-transform: uppercase;
    color: #fff;
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .pg-materials {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pg-materials li {
    font-size: 11px;
    font-weight: 300;
    color: #9a988f;
    border: 1px solid #2a2a2a;
    border-radius: 999px;
    padding: 4px 10px;
  }
  .pg-empty {
    margin: 40px 0 0;
    color: #7e7e7a;
    font-size: 14px;
  }

  @media (max-width: 1100px) {
    .pg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .pg {
      padding: 0 20px 64px;
    }
    .pg-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import '@/scripts/filters';
</script>

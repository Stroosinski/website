---
/**
 * Rozdziały Showcase — oryginał, linie 439-489.
 *
 * Każdy rozdział otwiera kadr filmowy (data-cine) z paralaksą, wjeżdżającym
 * podpisem i rozsuwaną żółtą kreską — to jest "the reveal". Pod nim siatka
 * kadrów z realizacji, każdy za zasłoną (odsłania się przy najechaniu)
 * i klikalny — otwiera galerię.
 *
 * showCopy pochodzi z ustawienia showcaseCopy = "Minimal - photos lead",
 * czyli domyślnie FAŁSZ: opisy, specyfikacje i podpisy kadrów są ukryte,
 * zgodnie z koncepcją "zdjęcia prowadzą". Zachowane 1:1.
 */
import type { Locale } from '@/i18n';
import pl from '@/content/showcase.pl.json';
import en from '@/content/showcase.en.json';

interface Props {
  lang: Locale;
  /** odpowiednik showCopy z oryginału — domyślnie wyłączone */
  showCopy?: boolean;
}
const { lang, showCopy = false } = Astro.props;

type Frame = { img: string; title: string; loc: string; imgs: string[] };
type Chapter = {
  id: string; n: string; short: string; label: string; t: string;
  punch: string; d: string; specs: { k: string; v: string }[];
  hero: string; frames: Frame[];
};
const chapters = (lang === 'pl' ? pl : en) as unknown as Chapter[];
const src = (p: string) => (p.startsWith('/') ? p : `/${p.replace(/\\/g, '/')}`);

/**
 * Warianty rozmiarowe generowane przez scripts/optimize-images.mjs.
 * Oryginały mają nawet 6000 px szerokości — w siatce kadrów (~300 px)
 * oznaczało to 20x więcej pikseli, niż potrzeba. `.sm` to 900 px,
 * `.lg` to 2000 px do widoku pełnoekranowego.
 */
const variant = (p: string, size: 'sm' | 'lg') =>
  src(p).replace(/\.(webp|jpe?g|png)$/i, `.${size}.webp`);
---

{
  chapters.map((ch) => (
    <section data-chapter={ch.id} style="border-top: 1px solid #161616;">
      <div
        data-cine
        style="position: relative; height: 82vh; min-height: 520px; overflow: hidden; background: #050505;"
      >
        <div style="position: absolute; inset: 0;">
          <img
            data-cine-img
            decoding="async"
            src={variant(ch.hero, 'lg')}
            alt={`${ch.t} — STOLMAR`}
            style="position: absolute; left: 0; top: -16%; width: 100%; height: 132%; object-fit: cover; opacity: 0.22; filter: grayscale(1) brightness(0.72); will-change: transform, opacity;"
          />
          <div
            aria-hidden="true"
            style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5,5,5,0.3) 0%, rgba(5,5,5,0) 34%, rgba(5,5,5,0.9) 100%);"
          />
          <span
            data-cine-num
            aria-hidden="true"
            style="position: absolute; right: 40px; top: 6%; font-weight: 900; font-size: clamp(120px, 20vw, 320px); line-height: 0.8; color: rgba(255,255,255,0.04); letter-spacing: -0.04em; pointer-events: none;"
          >
            {ch.n}
          </span>
          <div
            data-cine-cap
            style="position: absolute; left: 0; right: 0; bottom: 0; padding: 0 40px 52px; opacity: 0; transform: translateY(40px); will-change: opacity, transform;"
          >
            <div style="max-width: 1360px; margin: 0 auto;">
              <div
                data-cine-rule
                style="width: 180px; height: 2px; background: var(--signal-yellow); transform: scaleX(0); transform-origin: left; margin-bottom: 24px;"
              />
              <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--signal-yellow); margin-bottom: 16px;">
                {ch.label}
              </div>
              <h2 style="margin: 0 0 16px; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(30px, 4.6vw, 68px); line-height: 0.98; letter-spacing: -0.02em; max-width: 900px;">
                {ch.t}
              </h2>
              {showCopy && (
                <p style="margin: 0; font-size: clamp(16px, 1.6vw, 20px); font-weight: 400; line-height: 1.5; color: #FFFFFF; max-width: 640px;">
                  {ch.punch}
                </p>
              )}
            </div>
          </div>
        </div>
      </div>

      {showCopy && (
        <div style="max-width: 1360px; margin: 0 auto; padding: 52px 40px 8px;">
          <div
            class="stlm-cinemeta"
            style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: start;"
          >
            <p
              data-reveal
              style="margin: 0; font-size: 16px; font-weight: 300; line-height: 1.75; color: #9A988F; max-width: 560px;"
            >
              {ch.d}
            </p>
            <div data-reveal style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
              {ch.specs.map((sp) => (
                <div style="border-top: 2px solid var(--signal-yellow); padding-top: 12px;">
                  <div style="font-size: 10px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: #7E7E7A; margin-bottom: 8px;">
                    {sp.k}
                  </div>
                  <div style="font-size: 15px; font-weight: 700; color: #FFFFFF; letter-spacing: -0.01em; line-height: 1.2;">
                    {sp.v}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      <div
        class="stlm-cinegrid"
        style="max-width: 1360px; margin: 0 auto; padding: 40px 40px 88px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;"
      >
        {ch.frames.map((fr) => (
          <div
            data-hgroup
            data-hborder="1"
            data-reveal
            data-lb-open
            data-frame-title={fr.title}
            data-frame-loc={fr.loc}
            data-frame-imgs={JSON.stringify(fr.imgs.map((p) => variant(p, 'lg')))}
            role="button"
            tabindex="0"
            aria-label={`${fr.title}, ${fr.loc}`}
            style="border: 1px solid #222222; background: #0E0E0E; transition: border-color 0.42s ease; cursor: pointer;"
          >
            <div style="position: relative; aspect-ratio: 4 / 3; overflow: hidden;">
              <img
                data-h-img
                data-gray
                decoding="async"
                loading="lazy"
                data-off="0.45"
                data-on="0.92"
                src={variant(fr.img, 'sm')}
                width="900"
                height="675"
                alt={`${fr.title}, ${fr.loc} — realizacja STOLMAR`}
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; filter: grayscale(1) brightness(0.95); transform: scale(1.06); transition: opacity 0.72s cubic-bezier(0.16,1,0.3,1), filter 0.72s cubic-bezier(0.16,1,0.3,1), transform 0.72s cubic-bezier(0.16,1,0.3,1);"
              />
            </div>
            {showCopy && (
              <div style="padding: 13px 15px; border-top: 1px solid #222222;">
                <div style="font-size: 12px; font-weight: 700; color: #FFFFFF; letter-spacing: -0.01em; margin-bottom: 3px;">
                  {fr.title}
                </div>
                <div style="font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--signal-yellow);">
                  {fr.loc}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  ))
}

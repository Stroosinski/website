---
/**
 * Galeria pełnoekranowa — oryginał, linie 490-506.
 * Powłoka (przyciemnienie, panel, przycisk zamknięcia, tytuł i lokalizacja)
 * przeniesiona 1:1; animacje wejścia i wyjścia pochodzą z original.css
 * (stlm-lb-fade-*, stlm-lb-pop-*, stlm-lb-img*).
 *
 * UWAGA: w oryginale slajdy renderuje komponent Coverflow.jsx (karuzela 3D).
 * Tutaj jest na razie przeglądanie kadr po kadrze z tą samą oprawą i
 * animacją zmiany zdjęcia — karuzela zostanie doniesiona osobno.
 */
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const closeLabel = lang === 'pl' ? 'Zamknij' : 'Close';
const prevLabel = lang === 'pl' ? 'Poprzednie' : 'Previous';
const nextLabel = lang === 'pl' ? 'Następne' : 'Next';
---

<div
  class="stlm-lb-overlay"
  data-lb-overlay
  role="dialog"
  aria-modal="true"
  aria-label="Galeria"
  hidden
  style="position: fixed; inset: 0; z-index: 200; background: rgba(5,5,5,0.975); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); display: flex; align-items: center; justify-content: center; padding: 0;"
>
  <div
    class="stlm-lb-panel"
    data-lb-panel
    style="position: relative; width: 100vw; height: 100vh; background: transparent; display: flex; flex-direction: column;"
  >
    <div style="position: relative; flex: 1; min-height: 0; overflow: hidden; background: transparent;">
      <img
        data-lb-img
        alt=""
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: clamp(16px, 4vw, 56px); box-sizing: border-box;"
      />
      <button
        data-lb-prev
        type="button"
        aria-label={prevLabel}
        class="stlm-lb-nav"
        style="left: clamp(8px, 2vw, 24px);">‹</button
      >
      <button
        data-lb-next
        type="button"
        aria-label={nextLabel}
        class="stlm-lb-nav"
        style="right: clamp(8px, 2vw, 24px);">›</button
      >
    </div>

    <div
      style="flex: 0 0 auto; min-height: 92px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px clamp(24px, 4vw, 56px) 30px;"
    >
      <div>
        <div
          data-lb-title
          style="font-size: 14px; font-weight: 700; color: #FFFFFF; letter-spacing: -0.01em; margin-bottom: 4px;"
        >
        </div>
        <div
          data-lb-loc
          style="font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal-yellow);"
        >
        </div>
      </div>
      <div
        data-lb-counter
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.14em; color: #7E7E7A;"
      >
      </div>
    </div>

    <button
      data-lb-close
      type="button"
      aria-label={closeLabel}
      style="position: absolute; right: clamp(16px, 3vw, 34px); top: clamp(16px, 3vw, 34px); width: 44px; height: 44px; z-index: 3; display: flex; align-items: center; justify-content: center; font-size: 18px; font-family: inherit; color: #0A0A0A; background: var(--signal-yellow); border: 0; cursor: pointer;"
      >✕</button
    >
  </div>
</div>

<style is:global>
  .stlm-lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    line-height: 1;
    font-family: inherit;
    color: #f4f2ec;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid #222;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }
  .stlm-lb-nav:hover {
    border-color: rgba(239, 211, 43, 0.55);
    color: #efd32b;
  }
  .stlm-lb-nav:focus-visible,
  [data-lb-close]:focus-visible {
    outline: 2px solid #efd32b;
    outline-offset: 2px;
  }
</style>

<script>
  import '@/scripts/lightbox';
</script>

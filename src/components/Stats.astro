---
/** Pasek liczb - oryginał, linie 208-216. Style wpisane w kod celowo. */
import type { Locale } from '@/i18n';
import en from '@/content/site.en.json';
import pl from '@/content/site.pl.json';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const stats = (lang === 'pl' ? pl : en).stats as { k: string; v: string }[];
---

<section style="border-top: 1px solid #161616; border-bottom: 1px solid #161616;">
  <div style="max-width: 1360px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr);">
    {
      stats.map((s) => (
        <div style="padding: 40px; border-left: 1px solid #161616;">
          <div style="font-weight: 900; font-size: 56px; line-height: 1; color: #FFFFFF; letter-spacing: -0.02em;">
            {s.k}
          </div>
          <div style="margin-top: 12px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #7E7E7A;">
            {s.v}
          </div>
        </div>
      ))
    }
  </div>
</section>

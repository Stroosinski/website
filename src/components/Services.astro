---
/**
 * "Obszary specjalizacji" — trzy dyscypliny, oryginał linie 575-660.
 *
 * Układ naprzemienny: pole 01 i 03 mają tekst po lewej (1.15fr) i zdjęcie
 * po prawej (0.85fr), pole 02 odwrotnie i nosi klasę stlm-field-flip.
 * Ta klasa jest punktem zaczepienia reguły mobilnej z original.css, która
 * odwraca kolejność, żeby na telefonie zdjęcie nie wyprzedzało nagłówka.
 *
 * Style wpisane w kod celowo — nie zamieniać na klasy (patrz original.css).
 */
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const fields = [
  {
    n: '01',
    title: t('cap.c1t'),
    desc: t('cap.c1d'),
    items: [t('cap.c1a'), t('cap.c1b'), t('cap.c1c'), t('cap.c1e')],
    img: '/assets/imgc/field-01-pos.lg.webp',
    flip: false,
  },
  {
    n: '02',
    title: t('cap.c2t'),
    desc: t('cap.c2d'),
    items: [t('cap.c2a'), t('cap.c2b'), t('cap.c2c'), t('cap.c2e')],
    img: '/assets/imgc/retail-exhibitions.lg.webp',
    flip: true,
  },
  {
    n: '03',
    title: t('cap.c3t'),
    desc: t('cap.c3d'),
    items: [t('cap.c3a'), t('cap.c3b'), t('cap.c3c'), t('cap.c3e')],
    img: '/assets/imgc/events-hero.lg.webp',
    flip: false,
  },
];

const label =
  'font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--signal-yellow); margin-bottom: 24px;';
const heading =
  'margin: 0; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(34px, 4vw, 62px); line-height: 1.04; letter-spacing: -0.02em;';
const desc =
  'margin: 26px 0 0; max-width: 520px; font-weight: 300; font-size: 17px; line-height: 1.75; color: #9A988F;';
const row = 'display: flex; align-items: center; gap: 12px; font-size: 14px; color: #C9C7C1;';
const dash =
  'width: 16px; height: 2px; background: var(--signal-yellow); flex-shrink: 0;';
---

<section style="border-top: 1px solid #161616; border-bottom: 1px solid #161616;">
  <div style="max-width: 1360px; margin: 0 auto; padding: 0 40px;">
    <div
      data-reveal
      style="display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding: 52px 0 8px;"
    >
      <div
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase; color: var(--signal-yellow);"
      >
        {t('cap.eye')}
      </div>
    </div>

    {
      fields.map((f, i) => {
        const text = (
          <div data-reveal data-slide={f.flip ? 'right' : 'left'}>
            <div style={label}>FIELD / {f.n}</div>
            <h3 style={heading}>{f.title}</h3>
            <p style={desc}>{f.desc}</p>
            <div style="margin-top: 30px; display: flex; flex-direction: column; gap: 12px;">
              {f.items.map((item) => (
                <div style={row}>
                  <span aria-hidden="true" style={dash} />
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
        );

        const media = (
          <div data-reveal data-slide={f.flip ? 'left' : 'right'}>
            <div
              data-hgroup
              data-hborder="1"
              style="position: relative; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid #222222; transition: border-color 0.42s ease;"
            >
              <img
                data-h-img
                data-off="0.75"
                data-on="0.92"
                src={f.img}
                alt={f.title}
                loading="lazy"
                decoding="async"
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.75; transform: scale(1.06); transition: opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1), transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);"
              />
              <div
                aria-hidden="true"
                style="position: absolute; inset: 0; box-shadow: inset 0 0 62px 12px rgba(0,0,0,0.62);"
              />
              <img
                src="/assets/logo-mark-white.png"
                alt=""
                aria-hidden="true"
                style="position: absolute; right: 14px; top: 14px; width: clamp(30px, 3vw, 46px); opacity: 0.09;"
              />
            </div>
          </div>
        );

        const cols = f.flip
          ? 'minmax(0, 0.85fr) minmax(0, 1.15fr)'
          : 'minmax(0, 1.15fr) minmax(0, 0.85fr)';

        return (
          <div
            class={f.flip ? 'stlm-field-flip' : undefined}
            style={`display: grid; grid-template-columns: ${cols}; gap: clamp(32px, 5vw, 86px); align-items: center; padding: clamp(58px, 7vw, 96px) 0;${i > 0 ? ' border-top: 1px solid #161616;' : ''}`}
          >
            {f.flip ? media : text}
            {f.flip ? text : media}
          </div>
        );
      })
    }
  </div>
</section>

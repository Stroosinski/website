---
/**
 * "Wybrane artefakty" — układ bento, oryginał linie 217-260.
 * Klasa .stlm-bento jest punktem zaczepienia reguł mobilnych (rozkłada kafle
 * w kolumnę i zdejmuje sztywną wysokość), więc musi zostać.
 * Tytuły startują zakryte paskiem i odsłaniają się przy najechaniu (veil.ts).
 */
import { useTranslations, pathFor, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const workHref = pathFor('work', lang);
---

<section style="max-width: 1360px; margin: 0 auto; padding: 150px 40px 110px;">
  <div
    style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 56px; gap: 24px;"
  >
    <div>
      <div
        data-reveal
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--signal-yellow); margin-bottom: 18px;"
      >
        {t('arch.eyebrow')}
      </div>
      <h2
        data-reveal
        style="margin: 0; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(32px, 3.4vw, 50px); letter-spacing: -0.02em;"
      >
        {t('arch.h3')}
      </h2>
    </div>
    <a
      href={workHref}
      class="stlm-arch-link"
      style="font-family: inherit; font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #C9C7C1; background: none; border: 0; border-bottom: 1px solid #3A3A3A; padding: 0 0 6px; cursor: pointer; text-decoration: none;"
      >{t('arch.link')}</a
    >
  </div>

  <div
    class="stlm-bento"
    style="display: grid; grid-template-columns: 8fr 4fr; grid-template-rows: 1fr 1fr; gap: 20px; height: min(74vh, 720px);"
  >
    <div
      data-hgroup
      data-hborder="1"
      style="grid-row: 1 / span 2; position: relative; border: 1px solid #222222; overflow: hidden; cursor: pointer; transition: border-color 0.42s ease;"
    >
      <img
        data-h-img
        data-off="0.45"
        data-on="0.75"
        src="/assets/imgc/select-hero.lg.webp"
        alt={t('alt.wearMedicine')}
        loading="lazy"
        decoding="async"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; transform: scale(1.06); transition: opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1), transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);"
      />
      <div
        aria-hidden="true"
        style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.05) 55%);"
      >
      </div>
      <div style="position: absolute; left: 40px; right: 40px; bottom: 36px;">
        <span data-rd style="position: relative; display: inline-block;">
          <a
            href={workHref}
            class="stlm-tile-link"
            data-rd-text
            data-dim="0.14"
            style="display: inline-block; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(30px, 3.4vw, 52px); line-height: 1; letter-spacing: -0.01em; opacity: 0.14; transition: opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1); text-decoration: none;"
            >{t('bento.a.title')}</a
          >
          <span
            data-rd-bar
            aria-hidden="true"
            style="position: absolute; left: -3px; right: -3px; top: 6%; height: 88%; background: #222222; transform: scaleX(1); transform-origin: right; transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);"
          ></span>
        </span>
        <div
          style="margin-top: 14px; font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--signal-yellow);"
        >
          {t('bento.a.meta')}
        </div>
      </div>
    </div>

    <div
      data-hgroup
      data-hborder="1"
      style="position: relative; border: 1px solid #222222; overflow: hidden; cursor: pointer; transition: border-color 0.42s ease;"
    >
      <img
        data-h-img
        data-off="0.35"
        data-on="0.7"
        src="/assets/img/pos/popup-1.lg.webp"
        alt={t('alt.popup')}
        loading="lazy"
        decoding="async"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; transform: scale(1.06); transition: opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1), transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);"
      />
      <div
        aria-hidden="true"
        style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.1) 60%);"
      >
      </div>
      <div style="position: absolute; left: 28px; right: 28px; bottom: 26px;">
        <span data-rd style="position: relative; display: inline-block;">
          <a
            href={workHref}
            class="stlm-tile-link"
            data-rd-text
            data-dim="0.16"
            style="display: inline-block; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: 24px; line-height: 1; opacity: 0.16; transition: opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1); text-decoration: none;"
            >{t('bento.b.title')}</a
          >
          <span
            data-rd-bar
            aria-hidden="true"
            style="position: absolute; left: -2px; right: -2px; top: 4%; height: 92%; background: #2A2A2A; transform: scaleX(1); transform-origin: right; transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);"
          ></span>
        </span>
        <div
          style="margin-top: 10px; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #7E7E7A;"
        >
          {t('bento.b.meta')}
        </div>
      </div>
    </div>

    <div
      data-hgroup
      data-hborder="1"
      style="position: relative; border: 1px solid #222222; overflow: hidden; cursor: pointer; transition: border-color 0.42s ease;"
    >
      <img
        data-h-img
        data-off="0.35"
        data-on="0.7"
        src="/assets/imgc/house-store.lg.webp"
        alt={t('alt.houseStore')}
        loading="lazy"
        decoding="async"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.35; transform: scale(1.06); transition: opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1), transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);"
      />
      <div
        aria-hidden="true"
        style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.1) 60%);"
      >
      </div>
      <div style="position: absolute; left: 28px; right: 28px; bottom: 26px;">
        <span data-rd style="position: relative; display: inline-block;">
          <a
            href={workHref}
            class="stlm-tile-link"
            data-rd-text
            data-dim="0.16"
            style="display: inline-block; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: 24px; line-height: 1; opacity: 0.16; transition: opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1); text-decoration: none;"
            >{t('bento.c.title')}</a
          >
          <span
            data-rd-bar
            aria-hidden="true"
            style="position: absolute; left: -2px; right: -2px; top: 4%; height: 92%; background: #2A2A2A; transform: scaleX(1); transform-origin: right; transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);"
          ></span>
        </span>
        <div
          style="margin-top: 10px; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #7E7E7A;"
        >
          {t('bento.c.meta')}
        </div>
      </div>
    </div>
  </div>

  <div
    data-cursor-glow
    aria-hidden="true"
    style="position: fixed; left: -152px; top: -28px; width: 520px; height: 520px; margin-left: -260px; margin-top: -260px; border-radius: 50%; background: radial-gradient(circle, rgba(239,211,43,0.07) 0%, rgba(10,10,10,0) 65%); pointer-events: none; z-index: 60; mix-blend-mode: plus-lighter; opacity: 0; transition: opacity 0.42s ease;"
  >
  </div>
</section>

<style is:global>
  .stlm-arch-link:hover {
    color: #efd32b !important;
    border-bottom-color: #efd32b !important;
  }

  /* Kafel klikalny w całości — jak w oryginale (tam był onClick na kaflu).
     Link niesie tytuł realizacji jako tekst, więc wyszukiwarki mają czego się
     uchwycić, a rozciągnięty ::after łapie kliknięcie na całej powierzchni. */
  .stlm-tile-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .stlm-tile-link:focus-visible {
    outline: 2px solid #efd32b;
    outline-offset: 4px;
  }
</style>

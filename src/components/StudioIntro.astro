---
/**
 * Nagłówek strony Możliwości - oryginał, linie 561-573.
 * Druga linia nagłówka jest wypisywana i kasowana w pętli (typewriter.ts):
 * "Jeden warsztat." → "Każdy materiał." → "Każda technologia." → "Zero granic."
 * Kolor #3A3A3A dla linii cyklicznej jest z oryginału - ma być przygaszona.
 */
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  style="max-width: 1360px; margin: 0 auto; padding: 96px 40px 80px; min-height: calc(100vh - 72px); box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; position: relative;"
>
  <div
    style="font-size: 11px; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase; color: var(--signal-yellow); margin-bottom: 26px;"
  >
    {t('studio.eyebrow')}
  </div>

  <h1
    data-tw
    style="margin: 0; font-weight: 900; text-transform: uppercase; font-size: clamp(44px, 6.4vw, 96px); line-height: 0.94; letter-spacing: -0.02em;"
  >
    <span
      data-tw-line
      data-text={t('studio.h1a')}
      style="display: block; color: #FFFFFF; min-height: 0.94em;">{t('studio.h1a')}</span
    >
    <span data-tw-cycle style="display: block; color: #3A3A3A; min-height: 0.94em;"
      >{t('studio.h1b')}</span
    >
  </h1>

  <p
    data-reveal
    style="margin: 34px 0 0; max-width: 620px; font-weight: 300; font-size: 18px; line-height: 1.7; color: #C9C7C1;"
  >
    {t('studio.stand')}
  </p>

  <div aria-hidden="true" data-hero-cue style="position: absolute; right: 40px; bottom: 28px; z-index: 2;">
    <span
      style="display: block; width: 1px; height: 46px; background: #3A3A3A; position: relative; overflow: hidden;"
    >
      <span
        style="position: absolute; left: 0; top: -45%; width: 100%; height: 42%; background: var(--signal-yellow); animation: stlm-cue 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;"
      ></span>
    </span>
  </div>
</section>

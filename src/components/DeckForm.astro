---
/**
 * Sekcja z prezentacją do pobrania — oryginał, linie 665-690.
 *
 * Jak to działa teraz:
 *  1. adres e-mail leci do serwisu formularzy, więc STOLMAR dostaje kontakt,
 *  2. prezentacja pobiera się od razu w przeglądarce — użytkownik nie czeka
 *     na pocztę i dostaje plik nawet wtedy, gdy mail utknie w spamie,
 *  3. pojawia się komunikat z oryginału.
 *
 * Automatyczny e-mail z załącznikiem wymaga usługi pocztowej i klucza API —
 * gdy będzie skonfigurowany, wystarczy podać adres w PUBLIC_DECK_ENDPOINT,
 * a formularz zacznie wysyłać tam zamiast do serwisu formularzy.
 * Natychmiastowe pobranie zostaje niezależnie, bo jest szybsze i pewniejsze.
 */
import { useTranslations, type Locale } from '@/i18n';
import { FORM_ENDPOINT, DECK_FILE } from '@/config';
import en from '@/content/site.en.json';
import pl from '@/content/site.pl.json';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const f = (lang === 'pl' ? pl : en).form as { email: string; emailPh: string };

const deckEndpoint = import.meta.env.PUBLIC_DECK_ENDPOINT || FORM_ENDPOINT;
const ui =
  lang === 'pl'
    ? {
        sending: 'Wysyłanie...',
        error: 'Nie udało się wysłać. Spróbuj ponownie lub napisz na info@stolmar.co.',
        subject: 'Prośba o prezentację ze strony stolmar.co',
        download: 'Pobierz ponownie',
      }
    : {
        sending: 'Sending...',
        error: 'Could not send. Please try again or write to info@stolmar.co.',
        subject: 'Deck request from stolmar.co',
        download: 'Download again',
      };
---

<section style="border-top: 1px solid #161616; padding: clamp(56px, 6vw, 90px) 40px;">
  <div
    class="stlm-deck"
    style="max-width: 1360px; margin: 0 auto; border: 1px solid #222222; background: var(--surface-stage-raised, #161616); display: grid; grid-template-columns: 1.1fr 0.9fr;"
  >
    <div data-reveal style="padding: clamp(48px, 5vw, 64px); border-bottom: 1px solid #222222;">
      <div
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.34em; text-transform: uppercase; color: var(--signal-yellow); margin-bottom: 22px;"
      >
        {t('deck.eyebrow')}
      </div>
      <h2
        style="margin: 0 0 20px; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(30px, 3.6vw, 48px); line-height: 1.02; letter-spacing: -0.02em;"
      >
        {t('deck.h1')}
      </h2>
      <p
        style="margin: 0 0 28px; font-size: 16px; font-weight: 300; line-height: 1.75; color: #9A988F; max-width: 460px;"
      >
        {t('deck.body')}
      </p>
    </div>

    <div
      style="padding: clamp(48px, 5vw, 64px); border-left: 1px solid #222222; display: flex; flex-direction: column; justify-content: center;"
    >
      <!-- Stan po wysłaniu — teksty z oryginału (deck.sent*). -->
      <div data-deck-sent hidden>
        <span
          style="display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #0A0A0A; background: var(--signal-yellow); padding: 7px 12px; margin-bottom: 18px;"
          >{t('deck.sentBadge')}</span
        >
        <div
          style="font-weight: 900; text-transform: uppercase; font-size: 26px; color: #FFFFFF; letter-spacing: -0.01em; margin-bottom: 10px;"
        >
          {t('deck.sentTitle')}
        </div>
        <p style="margin: 0 0 20px; color: #C9C7C1; font-weight: 300; max-width: 340px; line-height: 1.7;">
          {t('deck.sentBody')}
        </p>
        <a
          href={DECK_FILE}
          download
          style="font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal-yellow); text-decoration: none; border-bottom: 1px solid rgba(239,211,43,0.4); padding-bottom: 3px;"
          >{ui.download} ↓</a
        >
      </div>

      <form
        data-deck-form
        method="POST"
        action={deckEndpoint}
        data-file={DECK_FILE}
        data-sending-label={ui.sending}
        data-error-label={ui.error}
        style="display: flex; flex-direction: column; gap: 20px;"
      >
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="cf-gotcha"
        />
        <input type="hidden" name="_subject" value={ui.subject} />
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="typ" value="prezentacja" />

        <label style="display: flex; flex-direction: column; gap: 8px;">
          <span
            style="font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #7E7E7A;"
            >{f.email}</span
          >
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder={f.emailPh}
            style="font-family: inherit; font-size: 15px; font-weight: 300; color: #F4F2EC; background: transparent; border: 0; border-bottom: 1px solid #3A3A3A; padding: 10px 0; transition: border-color 200ms ease;"
          />
        </label>

        <button type="submit" class="stlm-deck-btn">{t('deck.cta')}</button>

        <p data-deck-error hidden role="alert" class="cf-err"></p>

        <span
          style="font-size: 11px; color: #7E7E7A; text-align: center; letter-spacing: 0.02em;"
          >{t('deck.hint')}</span
        >
      </form>
    </div>
  </div>
</section>

<style is:global>
  .stlm-deck input[type='email']:focus {
    outline: none;
    border-bottom-color: var(--signal-yellow, #efd32b);
  }
  .stlm-deck input::placeholder {
    color: #5a5a57;
  }
  /* przycisk pełnej szerokości, rozmiar lg z design systemu */
  .stlm-deck-btn {
    display: flex;
    width: 100%;
    height: 54px;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans, 'Roboto', sans-serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-900, #0a0a0a);
    background: var(--signal-yellow, #efd32b);
    border: 1px solid transparent;
    border-radius: var(--radius-sm, 2px);
    cursor: pointer;
    transition: background 120ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stlm-deck-btn:hover {
    background: var(--signal-yellow-deep, #d9be18);
  }
  .stlm-deck-btn:active {
    transform: translateY(1px);
  }
  .stlm-deck-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  @media (max-width: 860px) {
    .stlm-deck {
      grid-template-columns: 1fr !important;
    }
    .stlm-deck > div:last-child {
      border-left: 0 !important;
    }
  }
</style>

<script>
  import '@/scripts/deck';
</script>

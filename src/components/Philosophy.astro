---
/** Sekcja "Wyważony kadr" — filozofia marki, ze zdjęciem za zasłoną. */
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="phil">
  <div class="phil-grid">
    <div class="phil-text">
      <p class="phil-eyebrow">{t('phil.eyebrow')}</p>
      <h2 class="phil-h2">{t('phil.h2')}</h2>
      <p class="phil-body">{t('phil.body')}</p>
    </div>
    <div></div>
    <figure class="phil-media" data-hgroup data-hborder="1">
      <img
        data-h-img
        data-off="0.55"
        data-on="0.85"
        src="/assets/imgc/measured-glimpse.jpg"
        alt={t('alt.measuredGlimpse')}
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
      />
      <div aria-hidden="true" class="phil-scrim"></div>
    </figure>
  </div>
</section>

<style>
  .phil {
    border-top: 1px solid #161616;
    background: linear-gradient(to bottom, #0a0a0a, #0d0d0d);
  }
  .phil-grid {
    max-width: 1360px;
    margin: 0 auto;
    padding: 150px 40px;
    display: grid;
    grid-template-columns: 5fr 1fr 6fr;
    gap: 32px;
    align-items: end;
  }
  .phil-text {
    padding-bottom: 24px;
  }
  .phil-eyebrow {
    margin: 0 0 26px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7e7e7a;
  }
  .phil-h2 {
    margin: 0 0 30px;
    font-weight: 900;
    text-transform: uppercase;
    color: #fff;
    font-size: clamp(34px, 3.6vw, 54px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .phil-body {
    margin: 0;
    max-width: 400px;
    font-weight: 300;
    font-size: 16px;
    line-height: 1.8;
    color: #9a988f;
  }
  .phil-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    max-height: 640px;
    border: 1px solid #222;
    overflow: hidden;
    transition: border-color 0.42s ease;
  }
  .phil-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    transform: scale(1.06);
    transition:
      opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .phil-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.05) 45%);
  }

  @media (max-width: 860px) {
    .phil-grid {
      grid-template-columns: 1fr;
      padding: 72px 20px;
      gap: 40px;
    }
    .phil-grid > div:nth-child(2) {
      display: none;
    }
  }
</style>

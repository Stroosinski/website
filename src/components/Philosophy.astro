---
/**
 * Sekcja "Wyważony kadr" - oryginał, linie 193-206.
 * Style wpisane w kod celowo (reguły mobilne dopasowują się po ich treści,
 * m.in. `.site div[style*="padding: 150px 40px"]`). Nie zamieniać na klasy.
 */
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section style="border-top: 1px solid #161616; background: linear-gradient(to bottom, #0A0A0A, #0D0D0D);">
  <div
    style="max-width: 1360px; margin: 0 auto; padding: 150px 40px; display: grid; grid-template-columns: 5fr 1fr 6fr; gap: 32px; align-items: end;"
  >
    <div style="padding-bottom: 24px;">
      <div
        data-reveal
        style="font-size: 11px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: #7E7E7A; margin-bottom: 26px;"
      >
        {t('phil.eyebrow')}
      </div>
      <h2
        data-reveal
        style="margin: 0 0 30px; font-weight: 900; text-transform: uppercase; color: #FFFFFF; font-size: clamp(34px, 3.6vw, 54px); line-height: 1.02; letter-spacing: -0.02em;"
      >
        {t('phil.h2')}
      </h2>
      <p
        data-reveal
        style="margin: 0; max-width: 400px; font-weight: 300; font-size: 16px; line-height: 1.8; color: #9A988F;"
      >
        {t('phil.body')}
      </p>
    </div>
    <div></div>
    <div
      data-reveal
      data-hgroup
      data-hborder="1"
      style="position: relative; aspect-ratio: 4 / 5; max-height: 640px; border: 1px solid #222222; overflow: hidden; transition: border-color 0.42s ease;"
    >
      <img
        data-h-img
        data-off="0.55"
        data-on="0.85"
        src="/assets/imgc/measured-glimpse.lg.webp"
        alt={t('alt.measuredGlimpse')}
        loading="lazy"
        decoding="async"
        style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.55; transform: scale(1.06); transition: opacity 0.72s cubic-bezier(0.16, 1, 0.3, 1), transform 0.72s cubic-bezier(0.16, 1, 0.3, 1);"
      />
      <div
        aria-hidden="true"
        style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0.05) 45%);"
      >
      </div>
    </div>
  </div>
</section>

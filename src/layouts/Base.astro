---
/**
 * Bazowy layout — jeden <head> dla całej strony.
 * Tu żyje cała warstwa SEO/GEO: meta, canonical, hreflang, Open Graph, JSON-LD.
 */
import '@/styles/ds.css';
// Globalne style przeniesione 1:1 z projektu Claude Design — w tym cały układ
// mobilny (punkty łamania 860/900/700 px) i obsługa prefers-reduced-motion.
import '@/styles/original.css';
// Świadome odstępstwa od oryginału, zamówione przez właściciela — trzymane
// osobno, żeby original.css pozostał wiernym odwzorowaniem projektu.
import '@/styles/overrides.css';
import Analytics from '@/components/Analytics.astro';
import { pathFor, type Locale, type RouteKey } from '@/i18n';

export interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** która to strona — steruje canonical i hreflang */
  route: RouteKey;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, lang, route, ogImage = '/assets/logo-full.png', noindex = false } =
  Astro.props;

const site = Astro.site ?? new URL('https://stolmar.co');
const canonical = new URL(pathFor(route, lang), site).href;
const plHref = new URL(pathFor(route, 'pl'), site).href;
const enHref = new URL(pathFor(route, 'en'), site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Fonty ładowane z wyprzedzeniem — te dwie wagi niosą pierwszy widok.
const preloadFonts = ['/fonts/Roboto-Black.woff2', '/fonts/Roboto-Regular.woff2'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Musi być jak najwyżej: ustawia odmowę zgód zanim cokolwiek wystartuje. -->
    <Analytics />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    <!-- Wersje językowe -->
    <link rel="alternate" hreflang="pl" href={plHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={plHref} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="STOLMAR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Ikona karty: znak marki na czarnym tle (#0A0A0A). Samo logo-mark.svg jest
      białe na przezroczystym, więc znikało na jasnym pasku kart. Generowane
      przez scripts/build-favicon.mjs.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0A0A" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    background: #0a0a0a;
    color: #f4f2ec;
    font-family: 'Roboto', system-ui, sans-serif;
    overflow-x: hidden;
  }
  ::selection {
    background: #efd32b;
    color: #0a0a0a;
  }
  /*
    Zabezpieczenie ogólne (2026-08-11): atrybut `hidden` musi wygrywać zawsze,
    niezależnie od tego, jaki `style="display: ..."` ktoś wpisze na tym samym
    elemencie. Bez tej reguły element z inline `display: flex` i atrybutem
    `hidden` jednocześnie jest WIDOCZNY, bo inline style ma wyższy priorytet
    niż domyślna reguła przeglądarki dla `[hidden]`. Dokładnie to powodowało,
    że komunikat "Otrzymano" w formularzu kontaktowym był widoczny od razu,
    a sam formularz nie znikał po wysłaniu — oba miały inline `display: flex`.
  */
  [hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

---
/**
 * Bazowy layout — jeden <head> dla całej strony.
 * Tu żyje cała warstwa SEO/GEO: meta, canonical, hreflang, Open Graph, JSON-LD.
 */
import '@/styles/ds.css';
import { pathFor, type Locale, type RouteKey } from '@/i18n';

export interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** która to strona — steruje canonical i hreflang */
  route: RouteKey;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, lang, route, ogImage = '/assets/logo-full.png', noindex = false } =
  Astro.props;

const site = Astro.site ?? new URL('https://stolmar.co');
const canonical = new URL(pathFor(route, lang), site).href;
const plHref = new URL(pathFor(route, 'pl'), site).href;
const enHref = new URL(pathFor(route, 'en'), site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Fonty ładowane z wyprzedzeniem — te dwie wagi niosą pierwszy widok.
const preloadFonts = ['/fonts/Roboto-Black.woff2', '/fonts/Roboto-Regular.woff2'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      preloadFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    <!-- Wersje językowe -->
    <link rel="alternate" hreflang="pl" href={plHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={plHref} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="STOLMAR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/logo-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/logo-mark.png" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    background: #0a0a0a;
    color: #f4f2ec;
    font-family: 'Roboto', system-ui, sans-serif;
    overflow-x: hidden;
  }
  ::selection {
    background: #efd32b;
    color: #0a0a0a;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

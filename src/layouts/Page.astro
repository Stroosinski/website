---
/** Layout strony: nagłówek + treść + stopka + dane strukturalne. */
import Base from './Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Schema from '@/components/Schema.astro';
import { meta } from '@/i18n/meta';
import type { Locale, RouteKey } from '@/i18n';

interface Props {
  lang: Locale;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const { title, description } = meta[route][lang];
const fullSchema = route === 'home' || route === 'contact';
---

<Base title={title} description={description} lang={lang} route={route}>
  <Schema slot="head" lang={lang} full={fullSchema} />
  <Header lang={lang} current={route} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
</Base>
